<div class="col-lg-6 grid-margin stretch-card">
  <div class="card">
    <div class="p-4 pr-5 border-bottom bg-light d-flex justify-content-between">
      <h4 class="card-title mb-0">Pie chart</h4>
      <div id="pie-chart-legend" class="mr-4"></div>
    </div>

    <div class="card-body d-flex">
      <canvas class="my-auto" id="pieChart" height="130"></canvas>
    </div>
  </div>
</div>

<script>
  const pieData = JSON.parse('<%- JSON.stringify(pieData) %>');
</script>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const data = pieData[0];

  const ctx = document.getElementById('pieChart').getContext('2d');

  new Chart(ctx, {
    type: 'pie',
    data: {
      labels: ['Pie 1', 'Pie 2', 'Pie 3', 'Pie 4'],
      datasets: [{
        data: [data.pie1, data.pie2, data.pie3, data.pie4],
        backgroundColor: [
          '#4CAF50',
          '#FFC107',
          '#F44336',
          '#341231'
        ]
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          display: true,
          position: 'right'
        }
      }
    }
  });
</script>